@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject IAuthService AuthService

<MudLayout Class="app-layout">

    <!-- Navbar -->
    <MudPaper Elevation="4" Class="mud-appbar px-4 d-flex justify-between align-center">
        <MudNavMenu Class="d-flex align-center">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Class="mx-2">Home</MudNavLink>
            <MudNavLink Href="/products" Class="mx-2">Products</MudNavLink>
            <MudNavLink Href="/about" Class="mx-2">About</MudNavLink>
            <MudNavLink Href="/cart" Class="mx-2">Cart</MudNavLink>

            <AuthorizeView>
                <Authorized Context="context">
                    @if (isAdmin)
                    {
                        <MudNavLink Href="/admin" Class="mx-2">Admin</MudNavLink>
                    }
                    else
                    {
                        <MudNavLink Href="/user" Class="mx-2">Profile</MudNavLink>
                    }

                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="HandleLogout" Size="Size.Small" Class="mx-2">Logout</MudButton>
                </Authorized>
                <NotAuthorized>
                    <MudNavLink Href="/login" Class="mx-2">Login</MudNavLink>
                    <MudNavLink Href="/register" Class="mx-2">Register</MudNavLink>
                </NotAuthorized>
            </AuthorizeView>
        </MudNavMenu>
    </MudPaper>

    <!-- Huvudinnehåll -->
    <MudMainContent>
        @Body
    </MudMainContent>

    <!-- Footer -->
    <div class="footer-wrapper">
        <div class="footer-section text-center">
            <MudText Typo="Typo.caption">© 2025 The Loading Bean. Coded with ☕️ & ❤️ by Tina.</MudText>
        </div>
    </div>

</MudLayout>

@code {
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        isAdmin = await AuthService.IsAdminAsync();
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }
}
