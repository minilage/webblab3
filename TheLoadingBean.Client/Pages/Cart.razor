@page "/cart"
@inject ICartService CartService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="cart-page-wrapper">
    <h2 class="page-title">Your Cart</h2>

    @if (cartItems.Count == 0)
    {
        <p>Your cart is empty.</p>
    }
    else
    {
        <MudPaper Class="cart-wrapper">
            @foreach (var item in cartItems)
            {
                <div class="cart-list-item">
                    <div class="cart-product-info">
                        <strong>@item.Name</strong>
                        <div class="text-muted">@($"{item.Price:0.00} kr")</div>
                    </div>

                    <div class="cart-controls">
                        <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                       OnClick="@(() => UpdateQuantity(item.Id, -1))"
                                       Color="Color.Primary" />
                        <span>@item.Quantity</span>
                        <MudIconButton Icon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => UpdateQuantity(item.Id, 1))"
                                       Color="Color.Primary" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       OnClick="@(() => RemoveFromCart(item.Id))"
                                       Color="Color.Error" />
                    </div>
                </div>
            }

            <div class="cart-summary text-center mt-4">
                <strong class="d-block mb-2">Total: @($"{total:0.00} kr")</strong>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GoToCheckout">
                    Go to checkout
                </MudButton>
            </div>
        </MudPaper>
    }
</div>

@code {
    private List<ProductResponseDto> cartItems = new();
    private decimal total;

    protected override async Task OnInitializedAsync()
    {
        cartItems = await CartService.GetCartItemsAsync() ?? new();
        total = await CartService.GetTotalAsync();
    }

    private async Task RemoveFromCart(string productId)
    {
        await CartService.RemoveFromCartAsync(productId);
        cartItems = await CartService.GetCartItemsAsync();
        total = await CartService.GetTotalAsync();
    }

    private async Task UpdateQuantity(string productId, int change)
    {
        await CartService.UpdateQuantityAsync(productId, change);
        cartItems = await CartService.GetCartItemsAsync();
        total = await CartService.GetTotalAsync();
    }

    private void GoToCheckout()
    {
        Nav.NavigateTo("/checkout");
    }

}
