@page "/checkout"
@inject ICartService CartService
@inject IOrderService OrderService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IAuthService authService

<h2>Checkout</h2>

@if (cartItems.Count == 0)
{
    <p>Your cart is empty.</p>
}
else
{
    <MudPaper Class="p-4">
        <h4>Order Summary</h4>
        <ul>
            @foreach (var item in cartItems)
            {
                <li>@item.Name x @item.Quantity (@($"{item.Price * item.Quantity:0.00} kr"))</li>
            }
        </ul>

        <p><strong>Total: @($"{total:0.00} kr")</strong></p>

        <MudButton Color="Color.Success" OnClick="PlaceOrder">Place Order</MudButton>
    </MudPaper>
}

@code {
    private List<ProductResponseDto> cartItems = new();
    private decimal total;

    protected override async Task OnInitializedAsync()
    {
        cartItems = await CartService.GetCartItemsAsync();
        total = await CartService.GetTotalAsync();
    }

    private async Task PlaceOrder()
    {
        var userId = await authService.GetUserIdAsync();

        if (string.IsNullOrWhiteSpace(userId))
        {
            Snackbar.Add("You must be logged in to place an order.", Severity.Error);
            Navigation.NavigateTo("/login");
            return;
        }

        var orderDto = new CreateOrderDto
        {
            CustomerId = userId,
            Items = cartItems.Select(p => new OrderItemDto
            {
                ProductId = p.Id,
                Quantity = p.Quantity,
                UnitPrice = p.Price
            }).ToList()
        };

        try
        {
            await OrderService.CreateOrderAsync(orderDto);
            await CartService.ClearCartAsync();
            Snackbar.Add("Order placed successfully!", Severity.Success);
            Navigation.NavigateTo("/user"); // Ändra till /profile om det passar bättre
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to place order: {ex.Message}", Severity.Error);
        }
    }
}
