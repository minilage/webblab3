@page "/user"
@using Microsoft.AspNetCore.Authorization
@using TheLoadingBean.Shared.DTOs
@using TheLoadingBean.Client.Services
@attribute [Authorize]
@inject IAuthService AuthService
@inject IOrderService OrderService
@inject ICartService CartService
@inject ISnackbar Snackbar
@inject HttpClient Http

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 mb-6">

    @if (user is not null)
    {
        <MudText Typo="Typo.h4" Class="mb-4 text-center">Hi, @user.FirstName!</MudText>
    }

    <MudCard Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h5" Class="mb-2">Your Profile</MudText>
            <MudDivider Class="my-2" />

            @if (user is not null)
            {
                <MudForm @ref="form">
                    <MudTextField @bind-Value="updateModel.FirstName" Label="First Name" Required="true" />
                    <MudTextField @bind-Value="updateModel.LastName" Label="Last Name" Required="true" />
                    <MudTextField @bind-Value="updateModel.Email" Label="Email" Required="true" />
                    <MudTextField @bind-Value="updateModel.Phone" Label="Phone" Required="true" />
                    <MudTextField @bind-Value="updateModel.Address" Label="Address" Required="true" />

                    <MudButton OnClick="UpdateCustomer" Color="Color.Primary" Variant="Variant.Filled" Class="mt-3">
                        Update Info
                    </MudButton>
                </MudForm>
            }
            else
            {
                <MudText>Loading user information...</MudText>
            }
        </MudCardContent>
    </MudCard>

    <MudCard Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h5" Class="mb-2">Order History</MudText>
            <MudDivider Class="my-2" />

            @if (orders is null || orders.Count == 0)
            {
                <MudText>You have not placed any orders yet.</MudText>
            }
            else
            {
                @foreach (var order in orders)
                {
                    <MudPaper Class="mb-3 p-3" Elevation="1">
                        <MudText><b>Order ID:</b> @order.Id</MudText>
                        <MudText><b>Date:</b> @order.OrderDate.ToShortDateString()</MudText>
                        <MudText><b>Total:</b> @($"{order.TotalAmount:F2} kr")</MudText>

                        <MudList T="object" Dense="true">
                            @foreach (var item in order.Items)
                            {
                                <MudListItem T="object">
                                    <MudText>
                                        <b>Product ID:</b> @item.ProductId — <b>Qty:</b> @item.Quantity × @($"{item.UnitPrice:F2} kr")
                                    </MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </MudPaper>
                }
            }
        </MudCardContent>
    </MudCard>

</MudContainer>

@code {
    private CustomerResponseDto? user;
    private List<OrderResponseDto> orders = new();
    private UpdateCustomerDto updateModel = new();
    private MudForm? form;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            user = await AuthService.GetCurrentUserAsync();
            orders = await OrderService.GetOrdersByUserAsync() ?? new();

            if (user is not null)
            {
                updateModel = new UpdateCustomerDto
                {
                    Email = user.Email,
                    FirstName = user.FirstName,
                    LastName = user.LastName,
                    Phone = user.Phone,
                    Address = user.Address
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add("Could not load user data: " + ex.Message, Severity.Error);
        }
    }

    private async Task UpdateCustomer()
    {
        if (user is null)
            return;

        await form!.Validate();

        try
        {
            var response = await Http.PutAsJsonAsync($"api/customer/{user.Id}", updateModel);
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Profile updated successfully!", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Update failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Something went wrong: {ex.Message}", Severity.Error);
        }
    }
}
