@page "/products"
@using TheLoadingBean.Shared.DTOs
@using TheLoadingBean.Client.Services
@inject IProductService ProductService
@inject ICartService CartService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Shop</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="products-section">
    <div class="popular-products-wrapper">
        <h2 class="popular-title">Browse Our Products</h2>
    </div>

    <!-- Filtersektion -->
    <div class="products-filter beige-filter">
        <MudTextField @bind-Value="searchTerm"
                      Placeholder="Search..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Filled"
                      Color="Color.Primary"
                      Margin="Margin.Dense"
                      Class="mb-2" />

        <MudSelect T="string"
                   Label="Category"
                   @bind-Value="selectedCategory"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Margin="Margin.Dense"
                   Class="mb-2">
            <MudSelectItem Value="@AllCategory">@AllCategory</MudSelectItem>
            @foreach (var category in categories)
            {
                <MudSelectItem Value="@category">@category</MudSelectItem>
            }
        </MudSelect>
    </div>

    <!-- Produktkort -->
    <MudGrid GutterSize="GutterSize.Small">
        @foreach (var product in FilteredProducts)
        {
            <MudItem xs="12" sm="6" md="4" lg="2" Class="d-flex">
                <MudCard Class="product-card">
                    <MudCardMedia Image="@product.ImageUrl" Alt="@product.Name" Class="product-image" />

                    <MudCardContent>
                        <MudText Typo="Typo.h6" Class="product-title">@product.Name</MudText>
                        <MudText Typo="Typo.body2">@product.Description</MudText>
                        <MudText Typo="Typo.subtitle2" Class="product-price">@($"{product.Price:0.00} kr")</MudText>
                        <MudText Typo="Typo.caption">Category: @product.Category</MudText>

                        @if (!product.IsAvailable || product.IsDiscontinued)
                        {
                            <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small">Out of Stock</MudChip>
                        }
                    </MudCardContent>

                    <MudCardActions Class="justify-center">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   Disabled="@(!product.IsAvailable || product.IsDiscontinued)"
                                   OnClick="@(() => AddToCart(product))">
                            Add to Cart
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
</MudContainer>

@code {
    private const string AllCategory = "All";

    private List<ProductResponseDto> products = new();
    private string searchTerm = "";
    private string selectedCategory = AllCategory;
    private List<string> categories = new();

    private IEnumerable<ProductResponseDto> FilteredProducts =>
        products.Where(p =>
            (string.IsNullOrWhiteSpace(searchTerm) ||
                (p.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.ProductNumber?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.Category?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false)) &&
            (string.IsNullOrWhiteSpace(selectedCategory) || selectedCategory == AllCategory || p.Category == selectedCategory)
        );

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = await ProductService.GetAllProductsAsync() ?? new();

            foreach (var p in products)
            {
                var fileName = SanitizeFileName(p.Name);
                p.ImageUrl = $"/images/{fileName}";
            }

            categories = products
                .Select(p => p.Category ?? "Unknown")
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Distinct()
                .OrderBy(c => c)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine("FEL: Kunde inte ladda produkter: " + ex.Message);
            Snackbar.Add("Kunde inte hämta produkter från servern.", Severity.Error);
        }
    }

    private string SanitizeFileName(string input)
    {
        return new string(input
            .ToLower()
            .Where(c => char.IsLetterOrDigit(c))
            .ToArray()) + ".png";
    }

    private async Task AddToCart(ProductResponseDto product)
    {
        var success = await CartService.TryAddToCartAsync(product);

        if (success)
        {
            Snackbar.Add($"{product.Name} added to cart.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Could not add product to cart.", Severity.Warning);
        }
    }
}
