@using TheLoadingBean.Shared.DTOs
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-4">@(_isEdit ? "Redigera produkt" : "Skapa ny produkt")</MudText>

        <MudTextField T="string" @bind-Value="Product.Name" Label="Namn" Required="true" />
        <MudTextField T="string" @bind-Value="Product.Description" Label="Beskrivning" Required="true" />
        <MudNumericField T="decimal" @bind-Value="Product.Price" Label="Pris" Required="true" />
        <MudTextField T="string" @bind-Value="Product.Category" Label="Kategori" Required="true" />
        <MudCheckBox T="bool" @bind-Value="Product.IsAvailable" Label="Tillgänglig" />
        <MudCheckBox T="bool" @bind-Value="Product.IsDiscontinued" Label="Utgått" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Secondary">Avbryt</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary">Spara</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ProductDto Product { get; set; } = new();
    [Parameter] public bool IsEdit { get; set; }
    private bool _isEdit => IsEdit;

    private void Submit() => MudDialog.Close(DialogResult.Ok(Product));
    private void Cancel() => MudDialog.Cancel();
}
} 